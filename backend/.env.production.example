DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=kukudiary.com,www.kukudiary.com

# Names cPanel shows after you create the database. They usually start with the
# account name, for example kukudiar_kuku — copy them exactly.
DB_NAME=kukudiar_kuku
DB_USER=kukudiar_kuku
DB_PASSWORD=replace-with-the-database-password
DB_HOST=localhost
DB_PORT=5432

PUBLIC_BASE_URL=https://www.kukudiary.com
SERVE_MEDIA=True
